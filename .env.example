# Copy to `.env` and adjust if needed. Compose loads `.env` automatically.
#
# Host port for the Postgres container. Change it when something else already
# uses 5432 on your machine (e.g. a native Postgres or another compose project).
POSTGRES_PORT=5432

# First platform owner, provisioned idempotently by the backend at startup (Phase 4).
# Both values must be set for the owner to be created; leave them unset to skip it.
# The credential is a bcrypt hash, not plaintext. Generate one with:
#   htpasswd -bnBC 10 "" 'your-password' | sed 's/^://' | tr -d '\n'
# Double every `$` as `$$` — compose interpolates `.env` values.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
