{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "grep -r *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "tail *": "allow"
    },
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "webfetch": {
      "*": "ask",
      "https://opencode.ai/*": "allow"
    }
  }
}
